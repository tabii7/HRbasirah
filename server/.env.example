# Copy to .env (server/.env) for local development.
# Production values should be set in your hosting provider (e.g. Render dashboard).

# Server port (Render injects this automatically).
# On macOS, port 5000 is often taken by AirPlay Receiver — use 5001 locally if needed.
PORT=5001

# Required in production. Use a long random string.
JWT_SECRET=replace_me_with_a_long_random_string

# Comma-separated list of allowed origins for CORS, e.g.
# CLIENT_URL=http://localhost:5173,https://your-frontend.onrender.com
CLIENT_URL=http://localhost:5173

# Default admin user email (seeded on first run if missing)
ADMIN_EMAIL=admin@basirah.local

# Where to keep the SQLite DB and uploaded files. Use a persistent disk path
# in production (e.g. /var/data and /var/data/uploads on Render).
# DATA_DIR=/var/data
# UPLOADS_DIR=/var/data/uploads

# Optional: absolute or server-relative path to the brand logo used on slips/PDFs.
# LOGO_PATH=assets/logo.png

# Optional: SMTP credentials for reference-letter admin notifications.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=no-reply@basirah.local
# ADMIN_NOTIFICATION_EMAIL=admin@basirah.local
